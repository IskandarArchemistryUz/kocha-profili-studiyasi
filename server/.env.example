# Nusxa oling: cp .env.example .env  — va qiymatlarni serverda toʻldiring. .env repoga tushmaydi.
DATABASE_URL=postgres://archemistry:PAROL@127.0.0.1:5432/archemistry
# openssl rand -base64 32 bilan yarating
OTP_PEPPER=
TICKET_SECRET=
# kod yuborish: log — faqat jurnalga (sinov), smtp — pochta orqali
OTP_SENDER=log
# smtp boʻlsa: smtps://LOGIN:PAROL@smtp.provayder.uz:465   (parolni faqat serverdagi .env ga yozing)
SMTP_URL=
MAIL_FROM=Archemistry Lab <kod@archemistry.uz>
# Google bilan kirish: Google Cloud → OAuth mijoz identifikatori (Web). Boʻsh — Google tugmasi chiqmaydi.
GOOGLE_CLIENT_ID=
# Payme Business → kassa: Merchant ID va kalit (test kassasida — test kaliti, PAYME_TEST=1)
# Kassa sozlamasida endpoint: https://api.archemistry.uz/pay/payme
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=1
# Click → xizmat: SERVICE_ID, MERCHANT_ID, SECRET_KEY
# Prepare: https://api.archemistry.uz/pay/click/prepare · Complete: https://api.archemistry.uz/pay/click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET=
# Multicard (Uzcard, Humo, Visa, Mastercard, Payme, Click, Uzum — bitta sahifa). Kabinetda callback:
#   https://api.archemistry.uz/pay/multicard/callback   (sxema: «success»)
# Sinov: MULTICARD_BASE=https://dev-mesh.multicard.uz
MULTICARD_APP_ID=
MULTICARD_SECRET=
MULTICARD_STORE_ID=
MULTICARD_BASE=https://mesh.multicard.uz
# summa birligi: tiyin (sukut) yoki sum — sinov toʻlovida tekshiring
MULTICARD_AMOUNT_UNIT=tiyin
# callback faqat shu IP dan (docs.multicard.uz); boʻsh — tekshirilmaydi
MULTICARD_IPS=195.158.26.90
# fiskal chek: MXIK va qadoq kodi (tasnif.soliq.uz: 10305008002000000, «xizmat (marta)» = 1514296)
OFD_MXIK=10305008002000000
OFD_PACKAGE_CODE=1514296
PAY_RETURN_URL=https://archemistry.uz/app/
ORIGINS=https://archemistry.uz,https://www.archemistry.uz
COOKIE_DOMAIN=.archemistry.uz
# egasi pochtasi (vergul bilan bir nechta): shu pochta bilan kirganda yuklashlar suv belgisisiz. GitHub sirida ham boʻlishi mumkin (deploy yozadi).
OWNER_EMAILS=
HOST=127.0.0.1
PORT=8080

# Hudud ma'lumoti keshi (Overpass va boshqalar): papka va hajm chegarasi, GB
# DATA_CACHE_DIR=/srv/archemistry/server/cache
# DATA_CACHE_GB=20

# Esri ochiq kaliti (GitHub sirlaridan deploy vaqtida yoziladi; faqat Basemaps, referrer bilan cheklangan)
# ARCGIS_API_KEY=

# Copernicus CDS shaxsiy tokeni — ERA5 shamol guli (/data/wind); GitHub sirlaridan deploy vaqtida yoziladi
# CDS_API_KEY=

# NASA POWER — kalitsiz zaxira shamol manbasi (/data/wind: ERA5 kaliti yoʻq yoki Copernicus yiqilsa). Oʻchirish: NASA_POWER=0
# NASA_POWER=1

# Agent «Maslahatchi» (Claude API). Kalit: platform.claude.com → API keys. Faqat shu yerda (serverdagi .env), chatga va repoga emas.
# Kalit boʻsh — agent oʻchiq. Console da: auto-reload oʻchiq yoki past, oylik spend limit qoʻyilgan boʻlsin.
# ANTHROPIC_API_KEY=
# qaysi xizmatlarda yoqilgan: mr, joy, ks, dk, chz (vergul bilan)
# AGENT_SERVICES=mr,joy
# AGENT_MODEL_SHORT=claude-haiku-5-5
# AGENT_MODEL_LONG=claude-sonnet-5-5
# kunlik chegaralar, $: bepul savollar uchun / hamma agent chaqiruvlari uchun
# AGENT_FREE_DAILY_USD=2
# AGENT_DAILY_USD=20
# model narxlari ($ / 1 mln token) — rasmiy narx sahifasidan: {"claude-sonnet-5-5":{"in":2,"out":10,"cr":0.2,"cw":2.5}}
# AGENT_PRICES=

# Render (fal.ai + Cloudflare R2). Kalitlar faqat shu yerda (serverdagi .env), chatga va repoga emas. Boʻsh — render oʻchiq.
# fal: fal.ai → Dashboard → Keys; hisob info@archemistry.uz, avto-toʻldirish oʻchiq.
# FAL_KEY=
# R2: Cloudflare → R2 → bucket «archemistry-render» → Manage API tokens (Object Read & Write, faqat shu bucket).
#   Bucket CORS: AllowedOrigins https://archemistry.uz, https://www.archemistry.uz; AllowedMethods PUT, GET; AllowedHeaders content-type.
#   Lifecycle: «in/» — 30 kun, «out/» va «th/» — 30 kun (toʻlaganlar uchun 12 oy — egasi qarori kutilmoqda).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=archemistry-render
# kunlik fal xarajati chegarasi, $ (chegarada Pro → Tez, keyin rad; 80 % da egasiga xabar)
# RENDER_DAILY_USD_CAP=20

# Loyihalar bulutda: R2_* boʻlsa avtomatik yoqiladi (hujjatlar projects/ prefiksida)
# bir hisob uchun jami joy, MB (sukut 500; egasiga chegara yoʻq)
# PROJECTS_QUOTA_MB=500
# webhook manzili asosi (fal shu yerga natija yuboradi): <asos>/render/hook
# RENDER_HOOK_BASE=https://api.archemistry.uz
